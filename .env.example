# ─── Kern ────────────────────────────────────────────────────────────────
# Database. LAAT DIT LEEG/UITGECOMMENTARIEERD om de INGEBOUWDE database te
# gebruiken (npm run dev regelt automatisch een lokale PostgreSQL — geen Docker
# of installatie nodig). Zet dit alleen als je een eigen database wilt gebruiken:
# DATABASE_URL="postgresql://woningwaker:woningwaker@localhost:5432/woningwaker?schema=public"

# Auth.js — mag leeg blijven voor lokaal; voor productie:
#   genereer met: openssl rand -base64 32
AUTH_SECRET="verander-mij-in-een-lange-willekeurige-string"
# Basis-URL van de app (voor callbacks, mails, push)
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ─── Redis / BullMQ (optioneel — zonder deze draaien jobs inline/no-op) ────
REDIS_URL="redis://localhost:6379"

# ─── E-mail (Resend) — optioneel ──────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="WoningWaker <meldingen@woningwaker.nl>"

# ─── Web Push (VAPID) — genereer met: npx web-push generate-vapid-keys ─────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:meldingen@woningwaker.nl"

# ─── Telegram (optioneel, Waker Plus) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=""

# ─── Betalingen — Mollie (aanbevolen voor NL: iDEAL + incasso) ─────────────
# Zonder key draaien upgrades in demo-modus (plan wordt direct omgezet).
# Vind je API-key in het Mollie-dashboard → Developers → API-keys (test_/live_).
MOLLIE_API_KEY=""

# ─── Betalingen — Stripe (alternatief) ────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_WAKER=""
STRIPE_PRICE_WAKER_PLUS=""

# ─── Overig ───────────────────────────────────────────────────────────────
# Cron-secret om /api/connectors/sync te beveiligen
CRON_SECRET="verander-mij"
# Eerste admin-account (krijgt ADMIN-rol bij seed)
ADMIN_EMAIL="admin@woningwaker.nl"
